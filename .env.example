# Namuna: haqiqiy token/parollarni faqat .env ichiga yozing.
TELEGRAM_BOT_TOKEN=BOTFATHER_TOKEN
DATABASE_URL=postgresql+asyncpg://USER:PASSWORD@localhost:5432/namoz
TEST_TELEGRAM_BOT_TOKEN=TEST_BOTFATHER_TOKEN
TEST_DATABASE_URL=postgresql+asyncpg://USER:PASSWORD@localhost:5432/namoz_test
GEMINI_API_KEY=GEMINI_KEY
MAIN_AGENT_ENABLED=true
MAIN_AGENT_VERSION=3
# Faqat tekshirilgan raqamli Telegram IDlar. Bo‘sh ro‘yxatda admin bo‘lmaydi.
ADMIN_TELEGRAM_IDS=[]
# Qo‘shimcha model IDlari JSON ro‘yxatida; tanlashdan oldin xizmat tekshiradi.
GEMINI_ALLOWED_MODELS=[]
# GEMINI_VOICE_MODEL=audio_va_json_qollaydigan_model
# GEMINI_MAIN_AGENT_MODEL=json_qollaydigan_model
# GEMINI_PRAYER_AGENT_MODEL=...
# GEMINI_NASIHAT_AGENT_MODEL=...
# GEMINI_REMINDER_AGENT_MODEL=...
# GEMINI_ACCOUNTING_AGENT_MODEL=...
